# Server Configuration
PORT=3000

# MongoDB Connection String
# Local:  mongodb://localhost:27017/kiddodb
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/kiddodb
MONGO_URI=mongodb://localhost:27017/kiddodb

# JWT Configuration
JWT_SECRET=kiddo_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Node Environment
NODE_ENV=development
